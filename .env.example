# Copy to .env (never commit .env) and fill in. Read by the bench AND by the
# Omnigent tool processes. After editing, run:  omnigent stop
#
# --- Model being attacked (the target) ---
TARGET_PROVIDER=groq
TARGET_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=gsk_your_key_here
# OPENROUTER_API_KEY=sk-or-...
TARGET_MIN_INTERVAL=2.2
#
# --- Detector (defense D3): model | heuristic ---
DETECTOR=model
#
# --- Lab budget ---
LAB_BUDGET_SAMPLES=150
MAX_N_PER_EXPERIMENT=8
#
# --- Model that powers the AGENTS (the lab's brain) ---
# LAB_PROVIDER: gemini | openrouter | groq | openai
LAB_PROVIDER=gemini
LAB_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_key
# Example OpenRouter: LAB_PROVIDER=openrouter  LAB_MODEL=openai/gpt-4.1-mini
